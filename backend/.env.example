PORT=4000
NODE_ENV=development

# Database (Neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Microsoft OAuth (Azure App Registration)
MS_CLIENT_ID=your-microsoft-client-id
MS_CLIENT_SECRET=your-microsoft-client-secret
MS_TENANT_ID=your-tenant-id
MS_REDIRECT_URI=http://localhost:4000/api/auth/microsoft/callback

# WhatsApp (Meta Business API)
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:3000

# Email — Brevo HTTP API (required on Render — SMTP port 587 is blocked by Render free tier)
# Get this from: Brevo → top-right menu → Settings → API Keys → Generate a new API key
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM_NAME=Nexus Pre
EMAIL_FROM_ADDRESS=noreply@nexuspre.com

# Email — Generic SMTP fallback (only for non-Render local dev, ignored if BREVO_API_KEY is set)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Cloudflare R2 file storage
# Get these from Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=nexuspre
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
